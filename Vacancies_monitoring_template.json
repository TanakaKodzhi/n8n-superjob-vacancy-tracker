    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{\n  (() => {\n    const escapeHtml = (str) => String(str || '')\n      .replace(/&/g, '&amp;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;');\n\n    if (!$json.profession || !Array.isArray($json.profession) || $json.profession.length === 0) {\n      return \"<b>Свежих вакансий за последние 24 часа не найдено.</b>\";\n    }\n\n    let message = \"<b>🔥 Свежие вакансии по тегам:</b>\\n<i>Python, Java, C++, Программист, Разработчик</i>\\n\\n\";\n    const limit = Math.min($json.profession.length, 7);\n\n    for (let i = 0; i < limit; i++) {\n      let title = escapeHtml($json.profession[i]);\n      let url = escapeHtml($json.link[i]);\n      let from = $json.payment_from ? $json.payment_from[i] : 0;\n      let to = $json.payment_to ? $json.payment_to[i] : 0;\n      let salary = \"по договорённости\";\n\n      if (from > 0 && to > 0) {\n        salary = `${from} – ${to} ₽`;\n      } else if (from > 0) {\n        salary = `от ${from} ₽`;\n      } else if (to > 0) {\n        salary = `до ${to} ₽`;\n      }\n\n      message += `🔹 <a href=\"${url}\">${title}</a>\\n💰 З/п: ${salary}\\n\\n`;\n    }\n\n    return message.trim();\n  })()\n}}",
        "additionalFields": {
          "appendAttribution": false,
